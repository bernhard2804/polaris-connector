[Unit]
Description=Polaris: Maschinengedaechtnis in den Projektordner spiegeln
# Ziel liegt typischerweise im Projektordner; fehlt es, endet der Lauf mit 75
# und der naechste Timer-Lauf holt nach.
# Liegen die Projektordner auf einem Laufwerk, das ein eigener Dienst einhaengt
# (z. B. rclone), legt install.sh Wants=/After= darauf als Drop-in
# <unit>.d/polaris-storage.conf an (--storage-unit; seit 2026-10-23).

[Service]
Type=oneshot
# Bei Sperre oder beim Einschlafen auslassen, der naechste Timer-Lauf holt nach
# (haengender Laufwerkszugriff blockierte am 2026-10-23 den Suspend).
ExecCondition=%h/.local/bin/polaris-awake
ExecStart=%h/.local/bin/polaris-memory-mirror
SuccessExitStatus=75
Nice=10
