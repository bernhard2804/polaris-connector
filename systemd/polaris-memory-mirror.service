[Unit]
Description=Polaris: Maschinengedaechtnis in den Projektordner spiegeln
# Ziel liegt typischerweise auf dem rclone-Laufwerk; fehlt es, endet der Lauf
# mit 75 und der naechste Timer-Lauf holt nach.
Wants=rclone-projekte.service
After=rclone-projekte.service

[Service]
Type=oneshot
# Bei Sperre oder beim Einschlafen auslassen, der naechste Timer-Lauf holt nach
# (haengender Laufwerkszugriff blockierte am 2026-10-23 den Suspend).
ExecCondition=%h/.local/bin/polaris-awake
ExecStart=%h/.local/bin/polaris-memory-mirror
SuccessExitStatus=75
Nice=10
