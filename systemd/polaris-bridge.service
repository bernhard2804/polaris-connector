[Unit]
Description=Polaris Bridge - verarbeitet die Polaris Inbox einmalig
# Schreibt in die Projektordner auf dem rclone-Mount ~/Projekte (kritische
# Regel im Maschinengedaechtnis). Fehlt der Ordner trotzdem, bleibt die Datei
# fuer einen neuen Versuch liegen ("retry", seit 2026-09-29).
Wants=rclone-projekte.service
After=rclone-projekte.service
# Keine Startbegrenzung: jeder Lauf ist kurz und beendet sich bei belegter
# Sperre sofort. Mit dem Standard-Limit legten viele Inbox-Ereignisse in
# kurzer Zeit Service und Path-Unit still (2026-09-29, 18:37).
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Bei Sperre oder beim Einschlafen auslassen, der naechste Timer-Lauf holt nach
# (haengender Laufwerkszugriff blockierte am 2026-10-23 den Suspend).
ExecCondition=%h/.local/bin/polaris-awake
ExecStart=%h/.local/bin/polaris process
